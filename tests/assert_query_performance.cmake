run_timed(10000 model-migration --file "${FIXTURES}/ModelMigration.pas" --symbol TCSFields --left-index "${FIXTURES}/diagnose-v500.jdi" --right-index "${FIXTURES}/diagnose-v600.jdi" --format json)
