if(NOT DEFINED TOOL OR NOT DEFINED FIXTURES OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "TOOL, FIXTURES, and OUTPUT are required")
endif()

function(run_timed limit_ms)
  set(args ${ARGN})
  string(TIMESTAMP started "%s")
  execute_process(COMMAND "${TOOL}" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  string(TIMESTAMP finished "%s")
  math(EXPR elapsed_ms "(${finished} - ${started}) * 1000")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Query failed: ${args}; output=${output}; error=${error}")
  endif()
  string(JSON schema ERROR_VARIABLE json_error GET "${output}" schema_version)
  if(json_error)
    message(FATAL_ERROR "Invalid JSON for ${args}: ${json_error}")
  endif()
  if(elapsed_ms GREATER limit_ms)
    message(FATAL_ERROR "Query exceeded ${limit_ms} ms: ${elapsed_ms} ms; ${args}")
  endif()
  if("${args}" MATCHES "symbol-origin")
    string(JSON source_scan GET "${output}" query_performance source_scan_ms)
    if(NOT source_scan EQUAL 0)
      message(FATAL_ERROR "symbol-origin performed a source scan")
    endif()
  endif()
endfunction()

